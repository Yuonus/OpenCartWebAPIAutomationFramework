{
    "compilerOptions": {
        "target": "ES2020",
        "module": "es2022",
        "moduleResolution": "bundler",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "types": [
            "node",
            "@playwright/test" // added new 
        ],
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "./dist",
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.json",
        "tests/**/*.ts", // I added/included the tests
        "*.config.ts"
        // "testdata/**/*.json"
    ],
    "exclude": [
        "node_modules",
        "dist",
        // "tests", -- tests were excluded so I comment it out
        "reports",
        "allure-results"
    ]
}